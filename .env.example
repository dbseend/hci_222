TRUEPRICE_API_BASE_URL=http://YOUR_BACKEND_HOST:8000
TRUEPRICE_EXCHANGE_RATE_API_URL=https://YOUR_EXCHANGE_RATE_HOST/v1/latest
TRUEPRICE_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://web-one-gold-53.vercel.app
TRUEPRICE_CORS_ALLOW_ORIGIN_REGEX=
GOOGLE_MAPS_WEB_API_KEY=YOUR_WEB_GOOGLE_MAPS_API_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
TRUEPRICE_MAX_IMAGE_UPLOAD_BYTES=8388608
TRUEPRICE_APP_ENV=development
TRUEPRICE_ALLOW_LOCAL_DATA_FALLBACK=true
TRUEPRICE_ENABLE_DEMO_FALLBACKS=false
TRUEPRICE_CATALOG_CACHE_TTL_SECONDS=300
TRUEPRICE_DEFAULT_REGION=cairo
TRUEPRICE_DETECTOR_MODE=yolo
TRUEPRICE_ALLOW_MOCK_DETECTOR=false
TRUEPRICE_YOLO_MODEL_PATH=backend/models/best.pt
TRUEPRICE_WARM_UP_DETECTOR=true
